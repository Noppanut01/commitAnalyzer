# ── Azure DevOps (required) ──────────────────────────────────────────────────
AZURE_ORG=your-organization
AZURE_PROJECT=your-project
AZURE_REPO=your-repository
AZURE_PAT=your-personal-access-token
AZURE_BRANCH=                        # optional — leave blank for all branches
SPRINT_START=2025-01-01
SPRINT_END=2025-01-14
SPRINT_NAME=Sprint 1

# ── Analysis mode ─────────────────────────────────────────────────────────────
# Options: claude | gemini | openai | azure_openai | ollama | keyword
ANALYSIS_MODE=keyword

# ── Claude (ANALYSIS_MODE=claude) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gemini (ANALYSIS_MODE=gemini) ────────────────────────────────────────────
GOOGLE_API_KEY=AIzaSy...             # Option A: Google AI Studio key
GEMINI_MODEL=gemini-2.0-flash        # or gemini-1.5-flash, gemini-1.5-pro

# Option B: Vertex AI (set GEMINI_USE_VERTEX=true and leave GOOGLE_API_KEY blank)
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=my-gcp-project
GOOGLE_CLOUD_REGION=us-central1

# ── OpenAI (ANALYSIS_MODE=openai) ────────────────────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini             # or gpt-4o, gpt-4-turbo

# ── Azure OpenAI (ANALYSIS_MODE=azure_openai) ────────────────────────────────
AZURE_OPENAI_ENDPOINT=https://my-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-4o          # deployment name (not model name)
AZURE_OPENAI_API_VERSION=2024-02-01

# ── Ollama (ANALYSIS_MODE=ollama) ────────────────────────────────────────────
OLLAMA_MODEL=qwen2.5:3b              # or qwen2.5:7b, qwen3:latest
OLLAMA_URL=http://localhost:11434
