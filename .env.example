# Azure DevOps configuration
AZURE_ORG=your-organization
AZURE_PROJECT=your-project
AZURE_REPO=your-repository
AZURE_PAT=your-personal-access-token
AZURE_BRANCH=                        # optional: e.g. main (leave blank for all branches)

# Analysis mode:
#   claude   — Claude AI via Anthropic API (best accuracy, costs $)
#   gemini   — Google Gemini via AI Studio or Vertex AI (Google Cloud credits)
#   ollama   — Local LLM via Ollama (free, needs ollama installed)
#   keyword  — Regex keyword rules (free, instant, no model needed)
ANALYSIS_MODE=claude

# Anthropic API — required only when ANALYSIS_MODE=claude
ANTHROPIC_API_KEY=your-anthropic-api-key

# Google Gemini — required only when ANALYSIS_MODE=gemini
#
#   Option A: Google AI Studio (free quota + pay-per-token)
#     Get key at: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-api-key
GEMINI_MODEL=gemini-2.0-flash        # gemini-2.0-flash | gemini-1.5-flash | gemini-1.5-pro
#
#   Option B: Vertex AI (Google Cloud credits)
#     1. Enable Vertex AI API in your GCP project
#     2. Run: gcloud auth application-default login
#     3. Set the vars below and GEMINI_USE_VERTEX=true
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1

# Ollama — required only when ANALYSIS_MODE=ollama
OLLAMA_MODEL=qwen2.5:3b          # qwen2.5:3b (M1 8GB) | qwen2.5:7b (16GB+)
OLLAMA_URL=http://localhost:11434

# Sprint configuration
SPRINT_START=2025-01-01              # YYYY-MM-DD
SPRINT_END=2025-01-14                # YYYY-MM-DD
SPRINT_NAME=Sprint 1
